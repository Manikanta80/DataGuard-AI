# Copy this file to .env and fill in ONE of the keys below.
# The project auto-detects whichever is set (see dataguard/chain.py:get_chat_model).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Semantic (embedding-based) retrieval in dataguard/chain.py currently
# requires OpenAI specifically (for OpenAIEmbeddings). Without it, DataQAChain
# automatically falls back to zero-dependency keyword retrieval — no key needed
# to explore the project, run tests, or run the LangGraph pipeline end to end.
